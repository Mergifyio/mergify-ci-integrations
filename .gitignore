# Staged at release time by .github/scripts/stage-ts-licenses.sh. Ignoring them
# does not keep them out of the tarballs -- npm packs a LICENSE it finds in the
# package directory regardless.
clients/ts/packages/*/LICENSE
clients/ts/packages/native/npm/*/LICENSE
