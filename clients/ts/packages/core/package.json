{
  "name": "@mergifyio/ci-core",
  "version": "0.0.0",
  "description": "Shared core for Mergify CI test framework plugins",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@mergifyio/ci-native": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mergifyio/mergify-ci-integrations.git",
    "directory": "clients/ts/packages/core"
  },
  "author": "Mergify <hello@mergify.com>"
}
