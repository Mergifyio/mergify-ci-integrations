{
  "name": "@mergifyio/playwright",
  "version": "0.0.0",
  "description": "Playwright reporter for Mergify CI Insights",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@mergifyio/ci-core": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.56.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "keywords": [
    "playwright",
    "test",
    "flaky-tests",
    "testing",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mergifyio/mergify-ci-integrations.git",
    "directory": "clients/ts/packages/playwright"
  },
  "author": "Mergify <hello@mergify.com>"
}
