{
  "name": "@mergifyio/vitest",
  "version": "0.0.0",
  "description": "Vitest reporter for Mergify CI Insights",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runner": {
      "import": {
        "types": "./dist/runner.d.mts",
        "default": "./dist/runner.mjs"
      },
      "require": {
        "types": "./dist/runner.d.cts",
        "default": "./dist/runner.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@mergifyio/ci-core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.10.0"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@vitest/runner": "^4.1.10",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "keywords": [
    "vitest",
    "test",
    "flaky-tests",
    "testing",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mergifyio/mergify-ci-integrations.git",
    "directory": "clients/ts/packages/vitest"
  },
  "author": "Mergify <hello@mergify.com>"
}
